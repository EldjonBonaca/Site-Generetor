# Port of the API server (the Vite dev server proxies /api to it)
PORT=4000

# Interface to listen on. Keep 127.0.0.1 behind nginx; 0.0.0.0 only if there is no proxy
# (the server refuses a non-local address without APP_PASSWORD).
HOST=127.0.0.1

# Number of reverse proxies in front of the app (1 behind nginx), so client IPs are correct.
TRUST_PROXY=0

# Login for the whole app (browser login prompt). REQUIRED on a public server.
# Leave APP_PASSWORD empty only for local use.
APP_USER=admin
APP_PASSWORD=

# 32-byte key used to encrypt AI provider API keys (AES-256-GCM).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If missing, the server generates one on first start and appends it to backend/.env.
# WARNING: if you lose/change it, saved API keys can no longer be decrypted (just re-enter them).
ENCRYPTION_KEY=

# Where images, kits, generated output and the SQLite DB are stored (relative to backend/)
STORAGE_DIR=../storage

# Upload limits (MB)
MAX_IMAGE_MB=15
MAX_KIT_MB=150

# Timeout for a single AI request (ms)
AI_TIMEOUT_MS=180000

# Default language of new projects (it, en, es, fr, de, pt, ...)
DEFAULT_LANGUAGE=it
